# Salidas de compilacion
build/
dist/

# Configuracion local de NetBeans
nbproject/private/

# Datos y modelos del entrenamiento offline (no viajan en la aplicacion)
herramientas/datos/
herramientas/salida/

# Bancos de sonido: assets grandes, se descargan aparte.
#
# Con barra inicial a proposito: sin ella, "sonido/" coincide con cualquier
# carpeta de ese nombre a cualquier profundidad, y eso incluye el paquete
# src/j4f/sonido/. Asi es como SalidaGervill.java y Estallidos.java llevaban
# ignorados en silencio desde que se crearon: compilaban porque el archivo
# seguia en el disco, pero nunca llegaron a un commit. Un clon limpio del
# repositorio no habria compilado.
/sonido/

# Muestras de audio: pesan y se regeneran con el volcado
canal/audio/

# Jars de OpenJFX y clases del motor hibrido (opcional): se generan con
# herramientas/PrepararMotorFx.java y no se comitean, igual que el banco de
# sonido. Con barra inicial: sin ella, "lib-fx/" coincidiria con cualquier
# carpeta de ese nombre a cualquier profundidad, que es justo el bug que
# se corrigio para "sonido/" mas arriba.
/lib-fx/
/build-fx/
